# ── DebtFree Coach v2 — environment config ─────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# Port the app listens on
PORT=3000

# Where the SQLite database file lives (Render disk mounts at /data)
DB_PATH=./data/debtfree.db

# Set to "production" on your host (enables secure cookies)
NODE_ENV=development

# Public URL of the deployed app, e.g. https://debtfree-coach.onrender.com
# Used for Stripe Checkout success/cancel redirects and the billing portal.
APP_URL=http://localhost:3000

# ── Stripe (all optional for local dev; required in production) ────────────
# Get these from https://dashboard.stripe.com (use TEST keys while testing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of the $9.99/month recurring product (starts with price_)
STRIPE_PRICE_ID=

# ── Dev-only convenience ───────────────────────────────────────────────────
# When true AND Stripe keys are absent, signing up grants a local 7-day
# trialing subscription so the full flow can be tested with no Stripe account.
# ALWAYS set to false (or remove) in production.
DEV_AUTO_SUBSCRIBE=true
